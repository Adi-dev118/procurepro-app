<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - RFQ Management</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../assets/css/style.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="../assets/img/favicon.ico" />
  </head>
  <body>
    <div class="dashboard-container">
      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <div class="logo">
            <i class="bi bi-shop logo-icon"></i>
            <span class="logo-text">AdminPanel</span>
          </div>
          <button class="toggle-btn">
            <i class="bi bi-chevron-left"></i>
          </button>
        </div>

        <nav class="sidebar-menu">
          <ul>
            <li>
              <a href="/admin/dashboard">
                <i class="bi bi-speedometer2"></i>
                <span class="menu-text">Dashboard</span>
              </a>
            </li>
            <li>
              <a href="/admin/users">
                <i class="bi bi-people"></i>
                <span class="menu-text">User Management</span>
              </a>
            </li>
            <li>
              <a href="/admin/suppliers">
                <i class="bi bi-truck"></i>
                <span class="menu-text">Vendor Management</span>
              </a>
            </li>
            <li>
              <a href="/admin/products">
                <i class="bi bi-box-seam"></i>
                <span class="menu-text">Product Management</span>
              </a>
            </li>
            <li>
              <a href="/admin/orders">
                <i class="bi bi-cart-check"></i>
                <span class="menu-text">Order Management</span>
              </a>
            </li>
            <li>
              <a href="/admin/rfqs" class="active">
                <i class="bi bi-file-earmark-text"></i>
                <span class="menu-text">RFQ Management</span>
              </a>
            </li>
            <li>
              <a href="/admin/disputes">
                <i class="bi bi-exclamation-triangle"></i>
                <span class="menu-text">Dispute Center</span>
              </a>
            </li>
            <li>
              <a href="/admin/settings">
                <i class="bi bi-gear"></i>
                <span class="menu-text">System Settings</span>
              </a>
            </li>
          </ul>
        </nav>

        <div class="sidebar-footer">
          <p>AdminPanel v1.0</p>
        </div>
      </aside>

      <!-- Mobile overlay -->
      <div class="mobile-overlay"></div>

      <!-- Main Content -->
      <main class="main-content">
        <!-- Topbar -->
        <header class="topbar">
          <button class="mobile-menu-btn">
            <i class="bi bi-list"></i>
          </button>

          <h1 class="page-title">RFQ Management</h1>

          <div class="topbar-actions">
            <div class="search-box">
              <i class="bi bi-search"></i>
              <input type="text" placeholder="Search..." />
            </div>

            <div class="notification-badge">
              <i class="bi bi-bell"></i>
              <span>3</span>
            </div>

            <div class="user-profile dropdown" style="position: relative">
              <button
                id="adminDropdownBtn"
                class="d-flex align-items-center gap-2 btn border-0"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                <div class="user-avatar"><span>AD</span></div>
                <span class="user-name">Admin User</span>
                <i class="bi bi-chevron-down"></i>
              </button>

              <ul class="dropdown-menu dropdown-menu-end mt-2" style="min-width: 220px">
                <li class="px-3 py-2 border-bottom">
                  <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar"><span>AD</span></div>
                    <div>
                      <div class="fw-medium">Admin User</div>
                      <small class="text-muted">admin@panel.com</small>
                    </div>
                  </div>
                </li>
                <li>
                  <a class="dropdown-item" href="/admin/profile">
                    <i class="bi bi-person me-2"></i>My Profile
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="/admin/settings">
                    <i class="bi bi-gear me-2"></i>System Settings
                  </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <a class="dropdown-item text-danger" href="/company/login" id="signoutButton">
                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </header>

        <!-- Content Wrapper -->
        <div class="content-wrapper rfqs-page">
          <!-- Page Header -->
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="section-title">RFQ Management</h1>
          </div>

          <!-- RFQ Stats -->
          <div class="row mb-4">
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Total RFQs</h6>
                      <h3 class="mb-0" id="stat-total"></h3>
                    </div>
                    <div class="stat-icon bg-primary">
                      <i class="bi bi-file-earmark-text"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 6% from last week
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Active RFQs</h6>
                      <h3 class="mb-0" id="stat-active"></h3>
                    </div>
                    <div class="stat-icon bg-warning">
                      <i class="bi bi-clock-history"></i>
                    </div>
                  </div>
                  <p class="text-danger mt-2 mb-0"><i class="bi bi-arrow-up"></i> 3 new today</p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Quotes Received</h6>
                      <h3 class="mb-0" id="stat-quotes"></h3>
                    </div>
                    <div class="stat-icon bg-info">
                      <i class="bi bi-chat-square-text"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 11 from yesterday
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Awarded / Closed</h6>
                      <h3 class="mb-0" id="stat-closed"></h3>
                    </div>
                    <div class="stat-icon bg-success">
                      <i class="bi bi-check-circle"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0"><i class="bi bi-arrow-up"></i> 8 this month</p>
                </div>
              </div>
            </div>
          </div>

          <!-- RFQ Table -->
          <div class="table-container">
            <div class="table-header">
              <div class="table-actions">
                <div class="input-group" style="width: 300px">
                  <input
                    type="text"
                    class="form-control"
                    id="rfq-search-input"
                    placeholder="Search RFQs..."
                  />
                  <button class="btn btn-outline-secondary" type="button" id="rfq-search-btn">
                    <i class="bi bi-search"></i>
                  </button>
                </div>

                <!-- Status Filter -->
                <div class="btn-group">
                  <button
                    class="btn btn-outline-secondary dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                  >
                    <i class="bi bi-filter me-1"></i>Status
                  </button>
                  <ul class="dropdown-menu">
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="">All</a>
                    </li>
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="active"
                        >Active</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="pending"
                        >Pending</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="awarded"
                        >Awarded</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="closed"
                        >Closed</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-status-filter" href="#" data-status="cancelled"
                        >Cancelled</a
                      >
                    </li>
                  </ul>
                </div>

                <!-- Priority Filter -->
                <div class="btn-group">
                  <button
                    class="btn btn-outline-secondary dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                  >
                    <i class="bi bi-filter me-1"></i>Priority
                  </button>
                  <ul class="dropdown-menu">
                    <li>
                      <a class="dropdown-item rfq-priority-filter" href="#" data-priority="">All</a>
                    </li>
                    <li>
                      <a class="dropdown-item rfq-priority-filter" href="#" data-priority="high"
                        >High</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-priority-filter" href="#" data-priority="medium"
                        >Medium</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-priority-filter" href="#" data-priority="low"
                        >Low</a
                      >
                    </li>
                  </ul>
                </div>

                <!-- Deadline Filter -->
                <div class="btn-group">
                  <button
                    class="btn btn-outline-secondary dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                  >
                    <i class="bi bi-calendar me-1"></i>Deadline
                  </button>
                  <ul class="dropdown-menu">
                    <li>
                      <a class="dropdown-item rfq-deadline-filter" href="#" data-range="">All</a>
                    </li>
                    <li>
                      <a class="dropdown-item rfq-deadline-filter" href="#" data-range="7days"
                        >Next 7 Days</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-deadline-filter" href="#" data-range="30days"
                        >Next 30 Days</a
                      >
                    </li>
                    <li>
                      <a class="dropdown-item rfq-deadline-filter" href="#" data-range="expired"
                        >Expired</a
                      >
                    </li>
                  </ul>
                </div>

                <button class="btn btn-outline-danger" id="rfq-clear-filters">Clear Filters</button>
                <button class="btn btn-outline-secondary" id="rfq-export-btn">
                  <i class="bi bi-download me-2"></i>Export
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-hover" id="rfq-table">
                <thead>
                  <tr>
                    <th>RFQ ID</th>
                    <th>Buyer</th>
                    <th>Budget Range</th>
                    <th>Qty</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Quotes</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="rfq-body">
                  <!-- Populated by JS -->
                </tbody>
              </table>

              <div class="pagination-container">
                <div class="pagination-info" id="rfq-pagination-info"></div>
                <nav>
                  <ul class="pagination" id="rfq-pagination"></ul>
                </nav>
              </div>
            </div>
          </div>

          <!-- Charts Row -->
          <div class="row mt-5">
            <div class="col-lg-8">
              <div class="chart-container">
                <div class="chart-header">
                  <h3 class="chart-title">RFQ Status Overview</h3>
                  <div class="dropdown">
                    <button
                      class="btn btn-outline-secondary btn-sm dropdown-toggle"
                      type="button"
                      data-bs-toggle="dropdown"
                    >
                      Last 30 days
                    </button>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item" href="#">Last 7 days</a></li>
                      <li><a class="dropdown-item" href="#">Last 30 days</a></li>
                      <li><a class="dropdown-item" href="#">Last 90 days</a></li>
                    </ul>
                  </div>
                </div>
                <div class="chart-placeholder">
                  <i class="bi bi-pie-chart me-2"></i>
                  RFQ Status Distribution Chart (Placeholder)
                </div>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="chart-container">
                <div class="chart-header">
                  <h3 class="chart-title">Budget by Category</h3>
                </div>
                <div class="chart-placeholder">
                  <i class="bi bi-bar-chart me-2"></i>
                  Budget by Category Chart (Placeholder)
                </div>
              </div>
            </div>
          </div>

          <!-- Recent RFQ Activity -->
          <div class="mt-5" id="rfq-activity-container"></div>
        </div>
        <!-- end content-wrapper -->
      </main>
    </div>
    <!-- end dashboard-container -->

    <!-- ==================== VIEW RFQ MODAL ==================== -->
    <div
      class="modal fade"
      id="viewRfqModal"
      tabindex="-1"
      aria-labelledby="viewRfqModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-xl">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="viewRfqModalLabel">
              <i class="bi bi-file-earmark-text me-2"></i>RFQ Details
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <div class="modal-body">
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="rfqDetailTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link active"
                  id="tab-details-btn"
                  data-bs-toggle="tab"
                  data-bs-target="#tab-details"
                  type="button"
                  role="tab"
                >
                  <i class="bi bi-info-circle me-1"></i>Details
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link"
                  id="tab-items-btn"
                  data-bs-toggle="tab"
                  data-bs-target="#tab-items"
                  type="button"
                  role="tab"
                >
                  <i class="bi bi-list-ul me-1"></i>Items
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link"
                  id="tab-quotes-btn"
                  data-bs-toggle="tab"
                  data-bs-target="#tab-quotes"
                  type="button"
                  role="tab"
                >
                  <i class="bi bi-chat-square-text me-1"></i>Quotes
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link"
                  id="tab-specs-btn"
                  data-bs-toggle="tab"
                  data-bs-target="#tab-specs"
                  type="button"
                  role="tab"
                >
                  <i class="bi bi-clipboard-data me-1"></i>Specifications
                </button>
              </li>
            </ul>

            <div class="tab-content" id="rfqDetailTabsContent">
              <!-- ── TAB 1: Details ── -->
              <div class="tab-pane fade show active" id="tab-details" role="tabpanel">
                <div class="row mb-3">
                  <!-- Buyer Info -->
                  <div class="col-md-6">
                    <h6 class="fw-semibold mb-2">Buyer Information</h6>
                    <div class="card p-3">
                      <p class="mb-1">
                        <strong>User ID:</strong> <span id="modal-user-id">—</span>
                      </p>
                      <p class="mb-0">
                        <strong>Location:</strong> <span id="modal-location">—</span>
                      </p>
                    </div>
                  </div>
                  <!-- RFQ Meta -->
                  <div class="col-md-6">
                    <h6 class="fw-semibold mb-2">RFQ Information</h6>
                    <div class="card p-3">
                      <div class="row">
                        <div class="col-6">
                          <p class="mb-1"><strong>RFQ ID:</strong></p>
                          <p class="mb-1"><strong>Created:</strong></p>
                          <p class="mb-1"><strong>Deadline:</strong></p>
                          <p class="mb-1"><strong>Priority:</strong></p>
                          <p class="mb-0"><strong>Status:</strong></p>
                        </div>
                        <div class="col-6">
                          <p class="mb-1" id="modal-rfq-id">—</p>
                          <p class="mb-1" id="modal-created-at">—</p>
                          <p class="mb-1" id="modal-deadline">—</p>
                          <p class="mb-1" id="modal-priority">—</p>
                          <p class="mb-0" id="modal-status">—</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Title & Description -->
                <h6 class="fw-semibold mb-2">Title &amp; Description</h6>
                <div class="card p-3 mb-3">
                  <p class="mb-1"><strong id="modal-title">—</strong></p>
                  <p class="mb-0 text-muted" id="modal-description">—</p>
                </div>

                <!-- Budget & Quantity -->
                <div class="row">
                  <div class="col-md-4">
                    <div class="card p-3 text-center">
                      <small class="text-muted text-uppercase fw-semibold">Min Budget</small>
                      <h4 class="text-primary mt-1 mb-0" id="modal-budget-min">—</h4>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="card p-3 text-center">
                      <small class="text-muted text-uppercase fw-semibold">Max Budget</small>
                      <h4 class="text-primary mt-1 mb-0" id="modal-budget-max">—</h4>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="card p-3 text-center">
                      <small class="text-muted text-uppercase fw-semibold">Quantity</small>
                      <h4 class="text-dark mt-1 mb-0" id="modal-quantity">—</h4>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ── TAB 2: Items ── -->
              <div class="tab-pane fade" id="tab-items" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>Specifications</th>
                      </tr>
                    </thead>
                    <tbody id="modal-items-body">
                      <tr>
                        <td colspan="4" class="text-center text-muted py-4">No items found</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- ── TAB 3: Quotes ── -->
              <div class="tab-pane fade" id="tab-quotes" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Quote ID</th>
                        <th>Supplier ID</th>
                        <th>Price (₹)</th>
                        <th>Message</th>
                        <th>Delivery Days</th>
                        <th>Warranty</th>
                        <th>Payment Terms</th>
                        <th>Status</th>
                        <th>Submitted</th>
                      </tr>
                    </thead>
                    <tbody id="modal-quotes-body">
                      <tr>
                        <td colspan="9" class="text-center text-muted py-4">No quotes yet</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- ── TAB 4: Specifications ── -->
              <div class="tab-pane fade" id="tab-specs" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Specification</th>
                        <th>Value</th>
                      </tr>
                    </thead>
                    <tbody id="modal-specs-body">
                      <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                          No specifications added
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <!-- end tab-content -->
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-outline-danger" id="modal-cancel-rfq-btn">
              <i class="bi bi-x-circle me-1"></i>Cancel RFQ
            </button>
            <button type="button" class="btn btn-primary" id="modal-print-btn">
              <i class="bi bi-printer me-1"></i>Print RFQ
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- end viewRfqModal -->

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="../assets/js/main.js"></script>
    <script type="module" src="../assets/js/admin/rfq/rfq.main.js"></script>

    <script>
      /* =========================================================
         RFQ Management – Inline Script
         Replace fetch URLs with your actual API endpoints.
      ========================================================= */

      /* ---------- Stats ---------- */
      async function loadRfqStats() {
        try {
          const res = await fetch('/api/v1/admin/rfq-stats');
          const data = await res.json();
          document.getElementById('stat-total').innerText = data.totalRfqs ?? 0;
          document.getElementById('stat-active').innerText = data.activeRfqs ?? 0;
          document.getElementById('stat-quotes').innerText = data.totalQuotes ?? 0;
          document.getElementById('stat-closed').innerText = data.closedRfqs ?? 0;
        } catch (err) {
          console.error('Error loading RFQ stats:', err);
        }
      }
    </script>
  </body>
</html>
