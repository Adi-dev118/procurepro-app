<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vendor Dashboard - RFQs</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="../assets/css/vendor.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="../assets/img/favicon.ico" />
  </head>
  <body>
    <div class="vendor-container">
      <!-- Sidebar -->
      <aside class="vendor-sidebar">
        <div class="vendor-sidebar-header">
          <div class="vendor-logo">
            <i class="bi bi-shop vendor-logo-icon"></i>
            <span class="vendor-logo-text">VendorHub</span>
          </div>
          <button class="vendor-toggle-btn">
            <i class="bi bi-chevron-left"></i>
          </button>
        </div>

        <nav class="vendor-sidebar-menu">
          <ul>
            <li>
              <a href="/vendor/dashboard">
                <i class="bi bi-speedometer2"></i>
                <span class="vendor-menu-text">Dashboard</span>
              </a>
            </li>
            <li>
              <a href="/vendor/products">
                <i class="bi bi-box-seam"></i>
                <span class="vendor-menu-text">Products</span>
              </a>
            </li>
            <li>
              <a href="/vendor/orders">
                <i class="bi bi-cart-check"></i>
                <span class="vendor-menu-text">Orders</span>
              </a>
            </li>
            <li>
              <a href="/vendor/rfqs" class="active">
                <i class="bi bi-chat-left-text"></i>
                <span class="vendor-menu-text">RFQs</span>
              </a>
            </li>
            <li>
              <a href="/vendor/finance">
                <i class="bi bi-credit-card"></i>
                <span class="vendor-menu-text">Finance</span>
              </a>
            </li>
            <li>
              <a href="/vendor/profile">
                <i class="bi bi-person-circle"></i>
                <span class="vendor-menu-text">Profile</span>
              </a>
            </li>
          </ul>
        </nav>

        <div class="vendor-sidebar-footer">
          <p class="vendor-name"></p>
          <small>Vendor Account</small>
        </div>
      </aside>

      <!-- Mobile overlay -->
      <div class="vendor-mobile-overlay"></div>

      <!-- Main Content -->
      <main class="vendor-main-content">
        <!-- Topbar -->
        <header class="vendor-topbar">
          <button class="vendor-mobile-menu-btn">
            <i class="bi bi-list"></i>
          </button>

          <h1 class="vendor-page-title">RFQ Management</h1>

          <div class="vendor-topbar-actions">
            <div class="vendor-search-box">
              <i class="bi bi-search"></i>
              <input type="text" placeholder="Search RFQs..." />
            </div>

            <div class="vendor-notification-badge">
              <i class="bi bi-bell"></i>
              <span>3</span>
            </div>

            <div id="navbarProfileContainer"></div>
          </div>
        </header>

        <!-- Content Wrapper -->
        <div class="vendor-content-wrapper vendor-rfqs-page">
          <!-- Page Header -->
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="vendor-section-title">Request for Quotations (RFQs)</h1>
            <div>
              <button class="btn btn-outline-primary me-2">
                <i class="bi bi-download me-2"></i>
                Export RFQs
              </button>
              <button class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>
                Create RFQ Alert
              </button>
            </div>
          </div>

          <!-- RFQ Stats -->
          <div class="row mb-4">
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Active RFQs</h6>
                      <h3 class="mb-0" id="active-rfq"></h3>
                    </div>
                    <div class="stat-icon bg-primary">
                      <i class="bi bi-chat-left-text"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 3 from last week
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Quotes Submitted</h6>
                      <h3 class="mb-0" id="quote-submitted"></h3>
                    </div>
                    <div class="stat-icon bg-success">
                      <i class="bi bi-check-circle"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 2 from yesterday
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Quotes Won</h6>
                      <h3 class="mb-0" id="quote-won"></h3>
                    </div>
                    <div class="stat-icon bg-info">
                      <i class="bi bi-trophy"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 1 from last week
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted">Success Rate</h6>
                      <h3 class="mb-0" id="success-rate">%</h3>
                    </div>
                    <div class="stat-icon bg-warning">
                      <i class="bi bi-graph-up"></i>
                    </div>
                  </div>
                  <p class="text-success mt-2 mb-0">
                    <i class="bi bi-arrow-up"></i> 5% from last month
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Tabs -->
          <ul class="nav nav-tabs vendor-nav-tabs" id="rfqTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="active-rfqs-tab"
                data-bs-toggle="tab"
                data-bs-target="#active-rfqs"
                type="button"
              >
                Active RFQs
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="submitted-quotes-tab"
                data-bs-toggle="tab"
                data-bs-target="#submitted-quotes"
                type="button"
              >
                Submitted Quotes
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="won-quotes-tab"
                data-bs-toggle="tab"
                data-bs-target="#won-quotes"
                type="button"
              >
                Won Quotes
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="lost-quotes-tab"
                data-bs-toggle="tab"
                data-bs-target="#lost-quotes"
                type="button"
              >
                Lost Quotes
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="expired-tab"
                data-bs-toggle="tab"
                data-bs-target="#expired-rfqs"
                type="button"
              >
                Expired
              </button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="rfqTabsContent">
            <!-- Active RFQs Tab -->
            <div class="tab-pane fade show active" id="active-rfqs" role="tabpanel">
              <div id="active-rfq-cards-container" class="mt-3"></div>
            </div>

            <!-- Submitted Quotes Tab -->
            <div class="tab-pane fade" id="submitted-quotes" role="tabpanel">
              <div class="vendor-table-container mt-3">
                <div class="vendor-table-responsive">
                  <table class="vendor-table">
                    <thead>
                      <tr>
                        <th>Quote ID</th>
                        <th>RFQ Title</th>
                        <th>Submitted Date</th>
                        <th>Quote Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="submitted-table-body"></tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="won-quotes" role="tabpanel">
              <div class="vendor-table-container mt-3">
                <div class="vendor-table-responsive">
                  <table class="vendor-table">
                    <thead>
                      <tr>
                        <th>Quote ID</th>
                        <th>RFQ Title</th>
                        <th>Submitted Date</th>
                        <th>Quote Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="won-table-body"></tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="tab-pane fade" id="lost-quotes" role="tabpanel">
              <div class="vendor-table-container mt-3">
                <div class="vendor-table-responsive">
                  <table class="vendor-table">
                    <thead>
                      <tr>
                        <th>Quote ID</th>
                        <th>RFQ Title</th>
                        <th>Submitted Date</th>
                        <th>Quote Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="lost-table-body"></tbody>
                  </table>
                </div>
              </div>
            </div>
            <div class="tab-pane fade show active" id="expired-rfqs" role="tabpanel">
              <div id="expired-rfq-cards-container" class="mt-3"></div>
            </div>
          </div>

          <!-- Quote Submission Form -->
          <div class="row mt-5">
            <div class="col-lg-8">
              <div class="vendor-form-section">
                <h3 class="vendor-section-title mb-4">Quick Quote Calculator</h3>
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label">Product Cost per Unit</label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" placeholder="0.00" step="0.01" />
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label">Quantity</label>
                      <input type="number" class="form-control" placeholder="0" />
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label">Shipping Cost</label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" placeholder="0.00" step="0.01" />
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label">Profit Margin (%)</label>
                      <div class="input-group">
                        <input type="number" class="form-control" value="20" min="0" max="100" />
                        <span class="input-group-text">%</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Additional Notes</label>
                  <textarea
                    class="form-control"
                    rows="3"
                    placeholder="Add any notes about the quote..."
                  ></textarea>
                </div>
                <div class="card mb-3">
                  <div class="card-body">
                    <h5 class="card-title">Quote Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                      <span>Total Cost:</span>
                      <span>$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>Shipping:</span>
                      <span>$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                      <span>Profit (20%):</span>
                      <span>$0.00</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                      <strong>Quote Total:</strong>
                      <strong>$0.00</strong>
                    </div>
                  </div>
                </div>
                <button class="btn btn-primary">Generate Quote</button>
              </div>
            </div>

            <div class="col-lg-4">
              <div class="vendor-chart-container">
                <div class="vendor-chart-header">
                  <h3 class="vendor-chart-title">Quote Success Rate</h3>
                </div>
                <div class="vendor-chart-placeholder">
                  <i class="bi bi-pie-chart me-2"></i>
                  Success Rate Chart (Placeholder)
                </div>
              </div>

              <div class="vendor-chart-container mt-4">
                <div class="vendor-chart-header">
                  <h3 class="vendor-chart-title">Recent Quote Activity</h3>
                </div>
                <div class="vendor-finance-list">
                  <div class="vendor-finance-item">
                    <div>
                      <strong>Quote #QT-001 Submitted</strong>
                      <div class="text-muted small">Electronics Components</div>
                    </div>
                    <span class="text-muted small">2 days ago</span>
                  </div>
                  <div class="vendor-finance-item">
                    <div>
                      <strong>Quote #QT-005 Won</strong>
                      <div class="text-muted small">Office Supplies</div>
                    </div>
                    <span class="text-muted small">1 week ago</span>
                  </div>
                  <div class="vendor-finance-item">
                    <div>
                      <strong>Quote #QT-003 Lost</strong>
                      <div class="text-muted small">Competitor lower price</div>
                    </div>
                    <span class="text-muted small">2 weeks ago</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div class="modal fade" id="submitQuoteModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border: none; border-radius: 12px; overflow: hidden">
          <div class="modal-header" style="padding: 20px 24px; border-bottom: 1px solid #f0f0f0">
            <h5 class="modal-title fw-semibold">
              <i class="bi bi-send me-2" style="color: var(--vendor-primary)"></i>Submit Quote
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" style="padding: 24px">
            <!-- RFQ label in modal -->
            <div
              class="mb-4 p-3 rounded-3"
              style="background: #f8f9fa; border-left: 3px solid var(--vendor-primary)"
            >
              <div
                style="
                  font-size: 10px;
                  font-weight: 700;
                  text-transform: uppercase;
                  letter-spacing: 0.07em;
                  color: #bbb;
                  margin-bottom: 4px;
                "
              >
                Responding to
              </div>
              <div
                id="quoteRfqTitle"
                style="font-size: 15px; font-weight: 600; color: var(--vendor-dark)"
              >
                —
              </div>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="vendor-form-label" style="font-size: 13px">
                  Your Price (₹) <span class="text-danger">*</span>
                </label>
                <input
                  type="number"
                  class="vendor-form-control"
                  id="quotePrice"
                  placeholder="e.g. 720000"
                  min="0"
                />
              </div>
              <div class="col-md-6">
                <label class="vendor-form-label" style="font-size: 13px">
                  Delivery Days <span class="text-danger">*</span>
                </label>
                <input
                  type="number"
                  class="vendor-form-control"
                  id="quoteDeliveryDays"
                  placeholder="e.g. 7"
                  min="1"
                />
              </div>
              <div class="col-md-6">
                <label class="vendor-form-label" style="font-size: 13px">
                  Payment Terms <span class="text-danger">*</span>
                </label>

                <select class="vendor-form-control" id="quotePaymentTerms">
                  <option value="">Select payment terms</option>
                  <option value="100% advance">100% Advance</option>
                  <option value="50% advance, 50% on delivery">50% Advance, 50% on Delivery</option>
                  <option value="30% advance, 70% on delivery">30% Advance, 70% on Delivery</option>
                  <option value="Net 30 days">Net 30 Days</option>
                  <option value="Net 45 days">Net 45 Days</option>
                  <option value="custom">Custom</option>
                </select>
              </div>
              <div class="col-12 d-none" id="customPaymentTermsWrapper">
                <label class="vendor-form-label" style="font-size: 13px">
                  Custom Payment Terms
                </label>

                <!-- Short structure -->
                <input
                  type="text"
                  class="vendor-form-control mb-2"
                  id="quotePaymentTermsCustom"
                  placeholder="e.g. 40% advance, 60% after delivery"
                />

                <!-- Detailed explanation -->
                <textarea
                  class="vendor-form-control"
                  id="quotePaymentTermsDetails"
                  rows="3"
                  placeholder="Describe detailed payment conditions (timelines, milestones, penalties, etc.)"
                  style="resize: vertical"
                ></textarea>
              </div>
              <div class="col-12">
                <label class="vendor-form-label" style="font-size: 13px">Message / Notes</label>
                <textarea
                  class="vendor-form-control"
                  id="quoteMessage"
                  rows="4"
                  placeholder="Describe your offer, delivery terms, warranty, or any additional details…"
                  style="resize: vertical"
                ></textarea>
              </div>
            </div>

            <div id="quoteError" class="alert alert-danger mt-3 mb-0 d-none"></div>
            <div id="quoteSuccess" class="alert alert-success mt-3 mb-0 d-none"></div>
          </div>
          <div
            class="modal-footer"
            style="padding: 16px 24px; border-top: 1px solid #f0f0f0; gap: 10px"
          >
            <button
              type="button"
              class="btn btn-outline-secondary"
              data-bs-dismiss="modal"
              style="border-radius: 8px"
            >
              Cancel
            </button>
            <button
              type="button"
              class="btn btn-primary"
              id="btnSubmitQuoteConfirm"
              style="border-radius: 8px; min-width: 140px"
            >
              <i class="bi bi-send me-1"></i>Submit Quote
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vendor JS -->
    <script src="../assets/js/vendor.js"></script>
    <script type="module" src="../assets/js/vendor/rfq/rfq.main.js"></script>
    <script type="module" src="/assets/js/vendor/profile/profile.main.js"></script>

    <script>
      let currentRfqId = null;

      // When modal opens → capture RFQ ID
      document
        .getElementById('submitQuoteModal')
        .addEventListener('show.bs.modal', function (event) {
          const button = event.relatedTarget;
          currentRfqId = button.getAttribute('data-rfq-id');
        });

      // Submit quote
      document.getElementById('btnSubmitQuoteConfirm').addEventListener('click', async function () {
        const price = document.getElementById('quotePrice').value.trim();
        const deliveryDays = document.getElementById('quoteDeliveryDays').value.trim();
        const message = document.getElementById('quoteMessage').value.trim();
        const paymentSelect = document.getElementById('quotePaymentTerms');

        const errEl = document.getElementById('quoteError');
        const okEl = document.getElementById('quoteSuccess');

        errEl.classList.add('d-none');
        okEl.classList.add('d-none');

        if (!price || !deliveryDays) {
          errEl.textContent = 'Price and Delivery Days are required.';
          errEl.classList.remove('d-none');
          return;
        }

        let paymentTerms = paymentSelect.value;

        if (paymentTerms === 'custom') {
          const short = document.getElementById('quotePaymentTermsCustom').value.trim();
          const details = document.getElementById('quotePaymentTermsDetails').value.trim();

          if (!short) {
            errEl.textContent = 'Please enter custom payment terms.';
            errEl.classList.remove('d-none');
            return;
          }

          paymentTerms = `${short}${details ? ' | ' + details : ''}`;
        }

        if (!paymentTerms) {
          errEl.textContent = 'Please select payment terms.';
          errEl.classList.remove('d-none');
          return;
        }

        this.disabled = true;
        this.innerHTML = 'Submitting...';

        try {
          const res = await fetch(`/api/v1/rfq/quotes/${currentRfqId}/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ price, deliveryDays, message, paymentTerms }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.message);

          okEl.textContent = 'Quote submitted successfully!';
          okEl.classList.remove('d-none');

          setTimeout(() => {
            bootstrap.Modal.getInstance(document.getElementById('submitQuoteModal'))?.hide();
          }, 1200);
        } catch (err) {
          errEl.textContent = err.message;
          errEl.classList.remove('d-none');
        } finally {
          this.disabled = false;
          this.innerHTML = 'Submit Quote';
        }
      });
    </script>
  </body>
</html>
