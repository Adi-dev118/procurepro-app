<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ProcurePro — RFQ Created</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="stylesheet" href="/assets/css/company-style.css" />
  </head>
  <body>
    <div class="shell">
      <!-- ── Sidebar ── -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
          <div class="logo-mark">P</div>
          <div>
            <div class="logo-name">ProcurePro</div>
            <div class="logo-badge">Buyer</div>
          </div>
        </div>

        <nav class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <a href="/company/dashboard" class="nav-item"><i class="bi bi-grid-1x2"></i> Dashboard</a>
          <a href="/company/marketplace" class="nav-item"><i class="bi bi-shop"></i> Marketplace</a>
          <a href="/company/rfq" class="nav-item active"
            ><i class="bi bi-megaphone"></i> My RFQs <span class="nav-badge">3</span></a
          >
          <a href="/company/orders" class="nav-item"><i class="bi bi-cart-check"></i> Orders</a>

          <div class="sidebar-section-label">Manage</div>
          <a href="/company/suppliers" class="nav-item"><i class="bi bi-people"></i> Suppliers</a>
          <a href="/company/invoices" class="nav-item"><i class="bi bi-receipt"></i> Invoices</a>
          <a href="/company/reports" class="nav-item"><i class="bi bi-bar-chart-line"></i> Reports</a>

          <div class="sidebar-section-label">Account</div>
          <a href="/company/settings" class="nav-item"><i class="bi bi-gear"></i> Settings</a>
          <a href="/company/help" class="nav-item"><i class="bi bi-question-circle"></i> Help & Support</a>
        </nav>

        <div class="sidebar-footer">
          <div class="user-popup" id="userPopup">
            <div class="user-popup-header">My Account</div>
            <a href="/company/profile" class="user-popup-item">
              <i class="bi bi-person-circle"></i> Profile
            </a>
            <a href="/company/cart" class="user-popup-item"> <i class="bi bi-cart3"></i> Cart </a>
            <a href="/company/settings" class="user-popup-item"> <i class="bi bi-gear"></i> Settings </a>
            <div class="user-popup-divider"></div>
            <a href="/company/login" class="user-popup-item danger" id="signoutButton">
              <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
          </div>
          <!-- User Card Trigger -->
          <div class="user-card" id="userCard"></div>
        </div>
      </aside>

      <!-- ── Main ── -->
      <div class="main">
        <!-- Top Bar -->
        <header class="topbar">
          <button class="icon-btn d-md-none" id="menuToggle" style="border: none">
            <i class="bi bi-list" style="font-size: 18px"></i>
          </button>
          <nav class="breadcrumb-nav">
            <a href="/company/dashboard">Dashboard</a>
            <span class="sep"><i class="bi bi-chevron-right" style="font-size: 10px"></i></span>
            <a href="/company/rfq">RFQs</a>
            <span class="sep"><i class="bi bi-chevron-right" style="font-size: 10px"></i></span>
            <span class="current">RFQ #</span>
          </nav>
          <div class="topbar-actions ms-auto">
            <div class="icon-btn" title="Notifications">
              <i class="bi bi-bell" style="font-size: 15px"></i>
              <span class="dot"></span>
            </div>
            <div class="icon-btn" title="Help">
              <i class="bi bi-question-circle" style="font-size: 15px"></i>
            </div>
          </div>
        </header>

        <!-- Page Content -->
        <div class="page-content">
          <!-- ── Success Banner ── -->
          <div class="success-banner">
            <div class="success-icon-wrap">
              <i class="bi bi-check2-circle"></i>
            </div>
            <div class="success-banner-text">
              <div class="sb-label">Request for Quotation</div>
              <div class="sb-heading">RFQ Published Successfully!</div>
              <div class="sb-sub">
                Your RFQ is now live and visible to matched suppliers. You'll receive quotations
                soon.
              </div>
              <div class="sb-rfq-id"><i class="bi bi-hash"></i> RFQ-</div>
            </div>
            <div class="success-banner-actions">
              <a href="/company/rfq" class="btn-success-outline">
                <i class="bi bi-list-ul"></i> All RFQs
              </a>
              <a href="/company/rfq/create" class="btn-success-outline">
                <i class="bi bi-plus-circle"></i> New RFQ
              </a>
            </div>
          </div>

          <!-- ── RFQ Overview ── -->
          <div class="section-card">
            <div class="section-header">
              <div>
                <div class="section-title">
                  <i
                    class="bi bi-info-circle"
                    style="color: var(--col-accent); margin-right: 6px"
                  ></i
                  >RFQ Overview
                </div>
                <div class="section-subtitle">Core details of your request</div>
              </div>
              <span class="status-badge"></span>
            </div>

            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-label">RFQ ID</div>
                <div class="detail-value mono">
                  <i class="bi bi-hash" style="color: var(--col-text-muted)"></i>RFQ-
                </div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Title</div>
                <div class="detail-value" id="rfqTitle"></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Category</div>
                <div class="detail-value" id="rfqCategory">
                  <i class="bi bi-tag" style="color: var(--col-accent)"></i>
                </div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Total Quantity</div>
                <div class="detail-value" id="rfqQuantity">
                  <i class="bi bi-boxes" style="color: var(--col-text-muted)"></i>
                  units
                </div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Deadline</div>
                <div class="detail-value" id="rfqDeadline">
                  <i class="bi bi-calendar-event" style="color: var(--col-warning)"></i>
                </div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Location</div>
                <div class="detail-value" id="rfqLocation">
                  <i class="bi bi-geo-alt" style="color: var(--col-danger)"></i>
                </div>
              </div>
              <div
                class="detail-item"
                style="grid-column: span 2; border-right: 1px solid var(--col-border)"
              >
                <div class="detail-label">Description</div>
                <div
                  class="detail-value"
                  style="font-weight: 400; font-size: 13.5px; line-height: 1.6; display: block"
                  id="rfqDesc"
                ></div>
              </div>
              <div class="detail-item">
                <div class="detail-label">Priority</div>
                <div class="detail-value">
                  <span class="priority-badge">
                    <i></i>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Budget ── -->
          <div class="section-card">
            <div class="section-header">
              <div>
                <div class="section-title">
                  <i
                    class="bi bi-currency-dollar"
                    style="color: var(--col-success); margin-right: 6px"
                  ></i
                  >Budget Range
                </div>
                <div class="section-subtitle">Your acceptable price window</div>
              </div>
            </div>
            <div class="budget-row">
              <div class="budget-block">
                <div class="budget-label">Minimum Budget</div>
                <div class="budget-value" style="color: var(--col-success)">₹</div>
              </div>
              <div class="budget-divider">—</div>
              <div class="budget-block">
                <div class="budget-label">Maximum Budget</div>
                <div class="budget-value" style="color: var(--col-accent)">₹</div>
              </div>
              <div class="budget-range-bar" title="Budget range visualization">
                <div class="budget-range-fill"></div>
              </div>
            </div>
          </div>

          <!-- ── Items ── -->
          <div class="section-card">
            <div class="section-header">
              <div>
                <div class="section-title">
                  <i class="bi bi-box-seam" style="color: var(--col-purple); margin-right: 6px"></i
                  >Requested Items
                </div>
                <div class="section-subtitle">item(s) in this RFQ</div>
              </div>
            </div>

            <div class="items-table-wrap">
              <table class="items-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                  </tr>
                </thead>
                <tbody id="itemsTable">
                  <tr>
                    <td><span class="item-num"></span></td>
                    <td class="product-name"></td>
                    <td>
                      <strong></strong>
                      <span style="color: var(--col-text-muted); font-size: 12px">units</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="empty-state">
              <i class="bi bi-box"></i>
              No items listed for this RFQ.
            </div>
          </div>

          <!-- ── Specifications ── -->

          <div class="section-card">
            <div class="section-header">
              <div>
                <div class="section-title">
                  <i class="bi bi-sliders" style="color: var(--col-warning); margin-right: 6px"></i
                  >Specifications
                </div>
                <div class="section-subtitle">specification(s) defined</div>
              </div>
            </div>
            <div class="specs-grid">
              <div class="spec-item">
                <div class="spec-icon"><i class="bi bi-ui-checks-grid"></i></div>
                <div>
                  <div class="spec-name"></div>
                  <div class="spec-value"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Action Footer ── -->
          <div class="section-card" style="margin-bottom: 0">
            <div class="action-footer">
              <a href="/company/rfq/quotes" class="btn-primary">
                <i class="bi bi-collection"></i> View Incoming Quotes
              </a>
              <a href="/company/rfq/edit" class="btn-outline"> <i class="bi bi-pencil"></i> Edit RFQ </a>
              <a href="/company/rfq" class="btn-outline"> <i class="bi bi-list-ul"></i> Back to RFQs </a>
              <a href="/company/rfq//close" class="btn-outline danger ms-auto">
                <i class="bi bi-x-circle"></i> Close RFQ
              </a>
            </div>
          </div>
        </div>
        <!-- /page-content -->
      </div>
      <!-- /main -->
    </div>
    <!-- /shell -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    
    <script type="module" src="/assets/js/company/profile/profile.main.js"></script>
    <script type="module" src="/assets/js/shared/logout.js"></script>

    <script>
      // Sidebar toggle (mobile)
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
            sidebar.classList.remove('open');
          }
        });
      }

      // ── User Account Popup ──
      const userCard = document.getElementById('userCard');
      const userPopup = document.getElementById('userPopup');
      if (userCard && userPopup) {
        userCard.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = userPopup.classList.toggle('open');
          userCard.classList.toggle('active', isOpen);
        });
        document.addEventListener('click', (e) => {
          if (!userCard.contains(e.target) && !userPopup.contains(e.target)) {
            userPopup.classList.remove('open');
            userCard.classList.remove('active');
          }
        });
      }
      const pathParts = window.location.pathname.split('/');
      const rfqId = pathParts[pathParts.length - 1];

      document.querySelector('.btn-primary').href = `/company/rfq/${rfqId}/quotes`;
      document.querySelector('.btn-outline.danger').href = `/company/rfq/${rfqId}/close`;

      console.log('RFQ ID:', rfqId);

      if (rfqId) {
        fetch(`/company/api/v1/rfq/rfq-data/${rfqId}`)
          .then((res) => res.json())
          .then((data) => {
            const rfq = data.rfq;

            // =====================
            // BASIC INFO
            // =====================

            document.querySelector('.sb-rfq-id').innerText = `#RFQ-${rfq.id}`;
            document.querySelector('#rfqTitle').innerText = rfq.title;

            // RFQ ID (top section)
            document.querySelector('.detail-value.mono').innerHTML = `
    <i class="bi bi-hash"></i> RFQ-${rfq.id}
  `;

            // Description
            document.querySelector('#rfqDesc').innerText = rfq.description;

            // Quantity
            document.querySelector('#rfqQuantity').innerHTML = `
    <i class="bi bi-boxes"></i> ${rfq.quantity} units
  `;

            const badge = document.querySelector('.status-badge');
            console.log(badge);
            if (rfq.status === 'active') {
              badge.classList.add('active');
              badge.innerHTML = `Active`;
            } else if (rfq.status === 'closed') {
              badge.classList.add('closed');
              badge.innerHTML = `Closed`;
            } else {
              badge.classList.add('pending');
              badge.innerHTML = `Pending`;
            }

            // Deadline
            const date = new Date(rfq.deadline).toLocaleDateString();
            document.querySelector('#rfqDeadline').innerHTML = `
    <i class="bi bi-calendar-event"></i> ${date}
  `;
            // Category
            document.querySelector('#rfqCategory').innerHTML =
              `<i class="bi bi-tag" style="color: var(--col-accent)" ></i> ${rfq.category}`;
            // Location
            document.querySelector('#rfqLocation').innerHTML = `
    <i class="bi bi-geo-alt"></i> ${rfq.location}
  `;

            // =====================
            // PRIORITY
            // =====================

            const priorityEl = document.querySelector('.priority-badge');
            priorityEl.classList.add(rfq.priority);
            priorityEl.innerText = rfq.priority.toUpperCase();

            // =====================
            // BUDGET
            // =====================

            document.querySelectorAll('.budget-value')[0].innerText = `₹${rfq.budget_min}`;
            document.querySelectorAll('.budget-value')[1].innerText = `₹${rfq.budget_max}`;

            // =====================
            // ITEMS
            // =====================

            const itemsContainer = document.querySelector('#itemsTable');

            if (rfq.items && rfq.items.length > 0) {
              itemsContainer.innerHTML = rfq.items
                .map(
                  (item, index) => `
        <tr>
          <td><span class="item-num">${index + 1}</span></td>
          <td class="product-name">${item.product_name}</td>
          <td><strong>${item.quantity}</strong> units</td>
        </tr>
      `,
                )
                .join('');

              document.querySelector('.empty-state').style.display = 'none';
            }

            // =====================
            // SPECIFICATIONS
            // =====================

            const specContainer = document.querySelector('.specs-grid');

            if (rfq.specifications && rfq.specifications.length > 0) {
              specContainer.innerHTML = rfq.specifications
                .map(
                  (spec) => `
        <div class="spec-item">
          <div class="spec-icon"><i class="bi bi-ui-checks-grid"></i></div>
          <div>
            <div class="spec-name">${spec.spec_name}</div>
            <div class="spec-value">${spec.spec_value}</div>
          </div>
        </div>
      `,
                )
                .join('');
            }
          });
        //
      }
    </script>
  </body>
</html>
