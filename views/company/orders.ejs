<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orders — ProcurePro</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../assets/css/style.css" />
    <link rel="stylesheet" href="../assets/css/company-style.css" />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
          <div class="logo-mark">P</div>
          <div>
            <div class="logo-name">ProcurePro</div>
            <div class="logo-badge">BUYER</div>
          </div>
        </div>
        <nav class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <a href="/dashboard" class="nav-item"
            ><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a
          >
          <a href="/marketplace" class="nav-item"
            ><i class="bi bi-shop"></i><span>Marketplace</span></a
          >
          <a href="/rfq" class="nav-item"
            ><i class="bi bi-megaphone"></i><span>RFQ Center</span
            ><span class="nav-badge warning">5</span></a
          >
          <div class="sidebar-section-label">Procurement</div>
          <a href="/orders" class="nav-item active"
            ><i class="bi bi-cart-check"></i><span>Orders</span><span class="nav-badge">3</span></a
          >
          <a href="/contracts" class="nav-item"
            ><i class="bi bi-file-earmark-text"></i><span>Contracts</span></a
          >
          <a href="/invoices" class="nav-item"
            ><i class="bi bi-receipt"></i><span>Invoices</span></a
          >
          <a href="/suppliers" class="nav-item"
            ><i class="bi bi-people"></i><span>Suppliers</span></a
          >
          <div class="sidebar-section-label">Account</div>
          <a href="/analytics" class="nav-item"
            ><i class="bi bi-bar-chart-line"></i><span>Analytics</span></a
          >
          <a href="/profile" class="nav-item"
            ><i class="bi bi-person-circle"></i><span>Profile & Team</span></a
          >
          <a href="/settings" class="nav-item"><i class="bi bi-gear"></i><span>Settings</span></a>
        </nav>
        <div class="sidebar-footer">
          <div class="user-popup" id="userPopup">
            <div class="user-popup-header">My Account</div>
            <a href="/profile" class="user-popup-item">
              <i class="bi bi-person-circle"></i> Profile
            </a>
            <a href="/cart" class="user-popup-item"> <i class="bi bi-cart3"></i> Cart </a>
            <a href="/settings" class="user-popup-item"> <i class="bi bi-gear"></i> Settings </a>
            <div class="user-popup-divider"></div>
            <a href="/company/login" class="user-popup-item danger">
              <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
          </div>

          <!-- User Card Trigger -->
          <div class="user-card" id="userCard"></div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <button class="icon-btn d-lg-none" id="menuToggle" style="border: none">
            <i class="bi bi-list" style="font-size: 18px"></i>
          </button>
          <span class="topbar-title d-none d-md-block">Orders & Transactions</span>
          <div class="topbar-search ms-auto ms-md-0">
            <i class="bi bi-search"></i
            ><input type="text" placeholder="Search orders, suppliers…" />
          </div>
          <div class="topbar-actions">
            <div class="icon-btn">
              <i class="bi bi-bell" style="font-size: 15px"></i><span class="dot"></span>
            </div>
            <button class="btn-ghost"><i class="bi bi-download"></i> Export</button>
          </div>
        </header>

        <div class="page-content">
          <div class="page-header">
            <div>
              <div class="page-title">Orders & Transactions</div>
              <div class="page-subtitle">Track purchases, invoices, and payments</div>
            </div>
          </div>

          <!-- KPI Cards -->
          <div class="kpi-grid">
            <div class="kpi-card">
              <div class="kpi-icon blue"><i class="bi bi-cart"></i></div>
              <div>
                <div class="kpi-val" id="total-order"></div>
                <div class="kpi-lbl">Total Orders</div>
              </div>
            </div>
            <div class="kpi-card">
              <div class="kpi-icon amber"><i class="bi bi-clock"></i></div>
              <div>
                <div class="kpi-val" id="pending-order"></div>
                <div class="kpi-lbl">Pending</div>
              </div>
            </div>
            <div class="kpi-card">
              <div class="kpi-icon teal"><i class="bi bi-truck"></i></div>
              <div>
                <div class="kpi-val" id="transit-order"></div>
                <div class="kpi-lbl">In Transit</div>
              </div>
            </div>
            <div class="kpi-card">
              <div class="kpi-icon green"><i class="bi bi-check-circle"></i></div>
              <div>
                <div class="kpi-val" id="complete-order"></div>
                <div class="kpi-lbl">Completed</div>
              </div>
            </div>
          </div>

          <!-- Filter Bar -->
          <div class="filter-bar">
            <div class="filter-group">
              <label>Status</label
              ><select class="filter-select">
                <option>All Status</option>
                <option>Pending</option>
                <option>Processing</option>
                <option>Shipped</option>
                <option>Delivered</option>
                <option>Cancelled</option>
              </select>
            </div>
            <div class="filter-group">
              <label>Date Range</label
              ><select class="filter-select">
                <option>All Time</option>
                <option>Last 7 Days</option>
                <option>Last 30 Days</option>
                <option>Last 90 Days</option>
                <option>This Month</option>
              </select>
            </div>
            <div class="filter-group">
              <label>Supplier</label
              ><select class="filter-select">
                <option>All Suppliers</option>
                <option>TechGadgets Ltd</option>
                <option>Global Supplies Inc.</option>
                <option>Precision Parts GmbH</option>
              </select>
            </div>
            <div class="filter-group">
              <label>Amount</label
              ><select class="filter-select">
                <option>Any Amount</option>
                <option>Under $1,000</option>
                <option>$1,000 – $5,000</option>
                <option>$5,000 – $10,000</option>
                <option>Over $10,000</option>
              </select>
            </div>
          </div>

          <!-- Orders Table -->
          <div class="section-card">
            <div class="section-header">
              <div>
                <div class="section-title">Order History</div>
                <div class="section-subtitle">All purchase orders</div>
              </div>
              <button class="btn-ghost"><i class="bi bi-funnel"></i> Filter</button>
            </div>
            <div class="table-wrapper">
              <table class="data-table orders-table">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Amount</th>
                    <th>Order Status</th>
                    <th>Payment</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="orders-table-body"></tbody>
              </table>
            </div>
            <div class="company-pagination-container mt-4">
              <div class="pagination-info"></div>
              <nav>
                <div id="pagination" class="pag-bar"></div>
              </nav>
            </div>
          </div>

          <!-- Tracking + Invoice -->
          <div class="two-col">
            <div class="section-card">
              <div class="section-header">
                <div>
                  <div class="section-title">Order Tracking</div>
                  <div class="section-subtitle">#ORD-7843 · DHL Express · TRK-789456123</div>
                </div>
                <span class="badge shipped"><span class="dot-indicator"></span>Shipped</span>
              </div>
              <div class="timeline">
                <div class="timeline-item">
                  <div class="tl-dot done"><i class="bi bi-check"></i></div>
                  <div class="tl-content">
                    <div class="tl-date">Nov 1, 2023</div>
                    <div class="tl-title">Order Placed</div>
                    <div class="tl-desc">Order confirmed and payment processed successfully.</div>
                  </div>
                </div>
                <div class="timeline-item">
                  <div class="tl-dot done"><i class="bi bi-check"></i></div>
                  <div class="tl-content">
                    <div class="tl-date">Nov 2, 2023</div>
                    <div class="tl-title">Order Processed</div>
                    <div class="tl-desc">Supplier confirmed and prepared for shipment.</div>
                  </div>
                </div>
                <div class="timeline-item">
                  <div class="tl-dot current"><i class="bi bi-truck"></i></div>
                  <div class="tl-content">
                    <div class="tl-date">Nov 4, 2023</div>
                    <div class="tl-title">Shipped</div>
                    <div class="tl-desc">
                      Tracking #: TRK-789456123 · Carrier: DHL Express · Est. delivery: Nov 8, 2023
                    </div>
                  </div>
                </div>
                <div class="timeline-item">
                  <div class="tl-dot pending"><i class="bi bi-geo-alt"></i></div>
                  <div class="tl-content">
                    <div class="tl-date">Expected Nov 8, 2023</div>
                    <div class="tl-title">Out for Delivery</div>
                    <div class="tl-desc">Package will be delivered to your facility today.</div>
                  </div>
                </div>
                <div class="timeline-item">
                  <div class="tl-dot pending"><i class="bi bi-house-check"></i></div>
                  <div class="tl-content">
                    <div class="tl-date">—</div>
                    <div class="tl-title">Delivered</div>
                    <div class="tl-desc">Order delivered and confirmed.</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="section-card">
              <div class="section-header"><div class="section-title">Invoice Details</div></div>
              <div class="invoice-body">
                <div class="invoice-row">
                  <span class="invoice-label">Subtotal</span
                  ><span class="invoice-value">$8,000.00</span>
                </div>
                <div class="invoice-row">
                  <span class="invoice-label">Shipping</span
                  ><span class="invoice-value">$300.00</span>
                </div>
                <div class="invoice-row">
                  <span class="invoice-label">Tax</span><span class="invoice-value">$150.00</span>
                </div>
                <div class="invoice-row total"><span>Total</span><span>$8,450.00</span></div>
                <div class="payment-info-box">
                  <div class="payment-info-row">
                    <span class="lbl">Method</span><span>Credit Card (•••• 1234)</span>
                  </div>
                  <div class="payment-info-row">
                    <span class="lbl">Date</span><span>Nov 1, 2023</span>
                  </div>
                  <div class="payment-info-row">
                    <span class="lbl">Status</span
                    ><span class="badge paid"><span class="dot-indicator"></span>Paid</span>
                  </div>
                </div>
                <div class="invoice-actions">
                  <button class="btn-outline-action">
                    <i class="bi bi-download"></i> Download Invoice
                  </button>
                  <button class="btn-outline-action">
                    <i class="bi bi-printer"></i> Print Invoice
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/company.js"></script>
    <script type="module" src="../assets/js/company/order/order.main.js"></script>
    <script type="module" src="../assets/js/company/profile/profile.main.js"></script>
    <script>
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !menuToggle.contains(e.target))
            sidebar.classList.remove('open');
        });
      }

      // ── User Account Popup ──
      const userCard = document.getElementById('userCard');
      const userPopup = document.getElementById('userPopup');
      if (userCard && userPopup) {
        userCard.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = userPopup.classList.toggle('open');
          userCard.classList.toggle('active', isOpen);
        });
        document.addEventListener('click', (e) => {
          if (!userCard.contains(e.target) && !userPopup.contains(e.target)) {
            userPopup.classList.remove('open');
            userCard.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>
