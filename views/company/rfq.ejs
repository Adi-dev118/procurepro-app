<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RFQ Center — ProcurePro</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../assets/css/style.css" />
    <link rel="stylesheet" href="../assets/css/company-style.css" />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
          <div class="logo-mark">P</div>
          <div>
            <div class="logo-name">ProcurePro</div>
            <div class="logo-badge">BUYER</div>
          </div>
        </div>
        <nav class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <a href="/company/dashboard" class="nav-item"
            ><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a
          >
          <a href="/company/marketplace" class="nav-item"
            ><i class="bi bi-shop"></i><span>Marketplace</span></a
          >
          <a href="/company/rfq" class="nav-item active"
            ><i class="bi bi-megaphone"></i><span>RFQ Center</span
            ><span class="nav-badge warning">5</span></a
          >
          <div class="sidebar-section-label">Procurement</div>
          <a href="/company/orders" class="nav-item"
            ><i class="bi bi-cart-check"></i><span>Orders</span><span class="nav-badge">3</span></a
          >
          <a href="/company/contracts" class="nav-item"
            ><i class="bi bi-file-earmark-text"></i><span>Contracts</span></a
          >
          <a href="/company/invoices" class="nav-item"
            ><i class="bi bi-receipt"></i><span>Invoices</span></a
          >
          <a href="/company/suppliers" class="nav-item"
            ><i class="bi bi-people"></i><span>Suppliers</span></a
          >
          <div class="sidebar-section-label">Account</div>
          <a href="/company/analytics" class="nav-item"
            ><i class="bi bi-bar-chart-line"></i><span>Analytics</span></a
          >
          <a href="/company/profile" class="nav-item"
            ><i class="bi bi-person-circle"></i><span>Profile & Team</span></a
          >
          <a href="/company/settings" class="nav-item"><i class="bi bi-gear"></i><span>Settings</span></a>
        </nav>
        <div class="sidebar-footer">
          <div class="user-popup" id="userPopup">
            <div class="user-popup-header">My Account</div>
            <a href="/company/profile" class="user-popup-item">
              <i class="bi bi-person-circle"></i> Profile
            </a>
            <a href="/company/cart" class="user-popup-item"> <i class="bi bi-cart3"></i> Cart </a>
            <a href="/company/settings" class="user-popup-item"> <i class="bi bi-gear"></i> Settings </a>
            <div class="user-popup-divider"></div>
            <a href="/company/login" class="user-popup-item danger" id="signoutButton">
              <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
          </div>

          <!-- User Card Trigger -->
          <div class="user-card" id="userCard"></div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <button class="icon-btn d-lg-none" id="menuToggle" style="border: none">
            <i class="bi bi-list" style="font-size: 18px"></i>
          </button>
          <span class="topbar-title d-none d-md-block">RFQ Center</span>
          <div class="topbar-search ms-auto ms-md-0">
            <i class="bi bi-search"></i><input type="text" placeholder="Search RFQs, tenders…" />
          </div>
          <div class="topbar-actions">
            <div class="icon-btn">
              <i class="bi bi-bell" style="font-size: 15px"></i><span class="dot"></span>
            </div>
            <a href="/company/rfq/create" class="btn-primary-action">
              <i class="bi bi-plus"></i>
              Create RFQ
            </a>
          </div>
        </header>

        <div class="page-content">
          <div class="page-header">
            <div>
              <div class="page-title">RFQ Center</div>
              <div class="page-subtitle">Manage your requests for quotation and tenders</div>
            </div>
          </div>

          <!-- Tabs -->
          <div class="tab-nav" id="rfqTabs">
            <button class="tab-btn active" data-tab="active">
              Active<span class="tab-count" id="active-rfq"></span>
            </button>
            <button class="tab-btn" data-tab="pending">
              Pending Review<span class="tab-count" id="pending-rfq"></span>
            </button>
            <button class="tab-btn" data-tab="closed">
              Closed / Awarded<span class="tab-count" id="closed-rfq"></span>
            </button>
            <button class="tab-btn" data-tab="draft">Drafts<span class="tab-count">1</span></button>
          </div>

          <!-- Tab Panels -->
          <div id="tab-active"></div>
          <div id="tab-pending" style="display: none"></div>
          <div id="tab-closed" style="display: none"></div>

          <div id="tab-draft" style="display: none"></div>

          <!-- Stats -->
          <div class="stats-row">
            <div class="stat-mini-card">
              <span class="stat-mini-icon" style="color: var(--col-accent)">📋</span>
              <div class="stat-mini-val">12</div>
              <div class="stat-mini-lbl">Total RFQs Created</div>
            </div>
            <div class="stat-mini-card">
              <span class="stat-mini-icon" style="color: var(--col-warning)">⏱</span>
              <div class="stat-mini-val">5</div>
              <div class="stat-mini-lbl">Avg. Bids per RFQ</div>
            </div>
            <div class="stat-mini-card">
              <span class="stat-mini-icon" style="color: var(--col-success)">💰</span>
              <div class="stat-mini-val">18%</div>
              <div class="stat-mini-lbl">Avg. Cost Savings</div>
            </div>
            <div class="stat-mini-card">
              <span class="stat-mini-icon" style="color: var(--col-purple)">✅</span>
              <div class="stat-mini-val">92%</div>
              <div class="stat-mini-lbl">RFQ Success Rate</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="viewQuoteModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Quote Details</h5>

            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body">
            <div class="mb-3">
              <label class="fw-semibold"> RFQ Title </label>

              <p id="viewRfqTitle"></p>
            </div>

            <div class="mb-3">
              <label class="fw-semibold"> Price </label>

              <p id="viewPrice"></p>
            </div>

            <div class="mb-3">
              <label class="fw-semibold"> Delivery Days </label>

              <p id="viewDelivery"></p>
            </div>

            <div class="mb-3">
              <label class="fw-semibold"> Payment Terms </label>

              <p id="viewPayment"></p>
            </div>

            <div class="mb-3">
              <label class="fw-semibold"> Status </label>

              <p id="viewStatus" class="quote-status"></p>
            </div>

            <div class="mb-3">
              <label class="fw-semibold"> Message </label>

              <p id="viewMessage"></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/company.js"></script>
    <script type="module" src="../assets/js/company/rfq/rfq.main.js"></script>
    <script type="module" src="../assets/js/company/profile/profile.main.js"></script>
    <script>
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !menuToggle.contains(e.target))
            sidebar.classList.remove('open');
        });
      }
      document.querySelectorAll('.tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          ['active', 'pending', 'closed', 'draft'].forEach((t) => {
            const el = document.getElementById('tab-' + t);
            if (el) el.style.display = 'none';
          });
          const panel = document.getElementById('tab-' + btn.dataset.tab);
          if (panel) panel.style.display = 'block';
        });
      });

      // ── User Account Popup ──
      const userCard = document.getElementById('userCard');
      const userPopup = document.getElementById('userPopup');
      if (userCard && userPopup) {
        userCard.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = userPopup.classList.toggle('open');
          userCard.classList.toggle('active', isOpen);
        });
        document.addEventListener('click', (e) => {
          if (!userCard.contains(e.target) && !userPopup.contains(e.target)) {
            userPopup.classList.remove('open');
            userCard.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>
