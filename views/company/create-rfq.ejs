<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create RFQ — ProcurePro</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="stylesheet" href="/assets/css/company-style.css" />
  </head>
  <body>
    <div class="shell">
      <!-- ── Sidebar ── -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
          <div class="logo-mark">P</div>
          <div>
            <div class="logo-name">ProcurePro</div>
            <div class="logo-badge">BUYER</div>
          </div>
        </div>

        <nav class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <a href="/dashboard" class="nav-item"
            ><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a
          >
          <a href="/marketplace" class="nav-item"
            ><i class="bi bi-shop"></i><span>Marketplace</span></a
          >
          <a href="/rfq" class="nav-item active">
            <i class="bi bi-megaphone"></i><span>RFQ Center</span>
            <span class="nav-badge warning">5</span>
          </a>

          <div class="sidebar-section-label">Procurement</div>
          <a href="/orders" class="nav-item"
            ><i class="bi bi-cart-check"></i><span>Orders</span><span class="nav-badge">3</span></a
          >
          <a href="/contracts" class="nav-item"
            ><i class="bi bi-file-earmark-text"></i><span>Contracts</span></a
          >
          <a href="/invoices" class="nav-item"
            ><i class="bi bi-receipt"></i><span>Invoices</span></a
          >
          <a href="/suppliers" class="nav-item"
            ><i class="bi bi-people"></i><span>Suppliers</span></a
          >

          <div class="sidebar-section-label">Account</div>
          <a href="/analytics" class="nav-item"
            ><i class="bi bi-bar-chart-line"></i><span>Analytics</span></a
          >
          <a href="/profile" class="nav-item"
            ><i class="bi bi-person-circle"></i><span>Profile & Team</span></a
          >
          <a href="/settings" class="nav-item"><i class="bi bi-gear"></i><span>Settings</span></a>
        </nav>

        <div class="sidebar-footer">
          <div class="user-popup" id="userPopup">
            <div class="user-popup-header">My Account</div>
            <a href="/profile" class="user-popup-item"
              ><i class="bi bi-person-circle"></i> Profile</a
            >
            <a href="/cart" class="user-popup-item"><i class="bi bi-cart3"></i> Cart</a>
            <a href="/settings" class="user-popup-item"><i class="bi bi-gear"></i> Settings</a>
            <div class="user-popup-divider"></div>
            <a href="/company/login" class="user-popup-item danger"
              ><i class="bi bi-box-arrow-left"></i> Sign Out</a
            >
          </div>
          <div class="user-card" id="userCard"></div>
        </div>
      </aside>

      <!-- ── Main ── -->
      <div class="main">
        <!-- Topbar -->
        <header class="topbar">
          <button class="icon-btn d-lg-none" id="menuToggle" style="border: none">
            <i class="bi bi-list" style="font-size: 18px"></i>
          </button>

          <div class="topbar-breadcrumb">
            <a href="/rfq">RFQ Center</a>
            <span class="sep">/</span>
            <span class="current">Create New RFQ</span>
          </div>

          <div class="topbar-actions">
            <div class="icon-btn" title="Notifications">
              <i class="bi bi-bell" style="font-size: 15px"></i>
              <span class="dot"></span>
            </div>
            <button class="btn-draft" id="saveDraftBtn" onclick="saveDraft()">
              <i class="bi bi-floppy"></i> Save Draft
            </button>
            <button class="btn-publish" onclick="document.getElementById('rfqSubmitBtn').click()">
              <i class="bi bi-send"></i> Publish RFQ
            </button>
          </div>
        </header>

        <!-- Page content -->
        <div class="page-content">
          <!-- Draft resume banner -->
          <div class="draft-banner" id="draftBanner">
            <i class="bi bi-clock-history"></i>
            <div class="draft-banner-text">
              <strong>Unsaved draft found</strong> — you have a draft RFQ from your last session.
            </div>
            <button class="btn-resume-draft" onclick="resumeDraft()">Resume Draft</button>
            <button class="btn-discard-draft" onclick="discardDraft()">Discard</button>
          </div>

          <div class="rfq-layout">
            <!-- Left: section nav -->
            <aside class="form-nav">
              <div class="form-nav-label">Sections</div>
              <div class="form-nav-list" id="formNavList">
                <a class="fnav-item active" href="#sec-basic">
                  <span class="fnav-num">1</span>
                  <span class="fnav-label">Basic Info</span>
                </a>
                <a class="fnav-item" href="#sec-specs">
                  <span class="fnav-num">2</span>
                  <span class="fnav-label">Specifications</span>
                </a>
                <a class="fnav-item" href="#sec-items">
                  <span class="fnav-num">3</span>
                  <span class="fnav-label">RFQ Items</span>
                </a>
                <a class="fnav-item" href="#sec-budget">
                  <span class="fnav-num">4</span>
                  <span class="fnav-label">Budget & Deadline</span>
                </a>
              </div>
            </aside>

            <!-- Right: form -->
            <div>
              <form id="createRFQForm" onsubmit="handleSubmit(event)">
                <div class="form-sections">
                  <!-- 1 · Basic Info -->
                  <div class="section-card" id="sec-basic">
                    <div class="section-head">
                      <span class="section-index">01</span>
                      <span class="section-title">Basic Information</span>
                    </div>
                    <div class="section-body">
                      <div class="field">
                        <label for="rfqTitle">RFQ Title <span class="req">*</span></label>
                        <input
                          type="text"
                          id="rfqTitle"
                          name="rfqTitle"
                          placeholder="e.g. Procurement of Industrial Valves — Q3 2025"
                          required
                        />
                      </div>

                      <div class="field-row">
                        <div class="field">
                          <label for="rfqCategory">Category <span class="req">*</span></label>
                          <select id="rfqCategory" name="rfqCategory" required>
                            <option value="other">Other</option>
                          </select>
                        </div>
                        <div class="field">
                          <label>Priority <span class="req">*</span></label>
                          <div class="priority-pills">
                            <input
                              type="radio"
                              class="ppill-input"
                              name="rfqPriority"
                              id="p-low"
                              value="low"
                            />
                            <label class="ppill-label" for="p-low">Low</label>
                            <input
                              type="radio"
                              class="ppill-input"
                              name="rfqPriority"
                              id="p-med"
                              value="medium"
                            />
                            <label class="ppill-label" for="p-med">Medium</label>
                            <input
                              type="radio"
                              class="ppill-input"
                              name="rfqPriority"
                              id="p-high"
                              value="high"
                            />
                            <label class="ppill-label" for="p-high">High</label>
                          </div>
                          <!-- hidden select keeps priority in form data -->
                          <select name="rfqPriorityVal" id="rfqPriorityVal" style="display: none">
                            <option value="low">low</option>
                            <option value="medium">medium</option>
                            <option value="high">high</option>
                          </select>
                        </div>
                      </div>

                      <div class="field">
                        <label for="rfqDescription">Description <span class="req">*</span></label>
                        <textarea
                          id="rfqDescription"
                          name="rfqDescription"
                          placeholder="Describe the procurement requirement — quantity expectations, technical standards, delivery conditions..."
                          required
                        ></textarea>
                      </div>

                      <div class="field">
                        <label for="rfqLocation"
                          >Delivery Location <span class="req">*</span></label
                        >
                        <input
                          type="text"
                          id="rfqLocation"
                          name="rfqLocation"
                          placeholder="e.g. Pune Warehouse, Plot 14, Chakan MIDC"
                          required
                        />
                      </div>
                    </div>
                  </div>

                  <!-- 2 · Specifications -->
                  <div class="section-card" id="sec-specs">
                    <div class="section-head">
                      <span class="section-index">02</span>
                      <span class="section-title">Specifications</span>
                    </div>
                    <div class="section-body">
                      <div class="row-header spec-cols">
                        <span>Spec Name</span>
                        <span>Spec Value</span>
                        <span></span>
                      </div>

                      <div class="dynamic-rows" id="specificationsContainer">
                        <div class="spec-row">
                          <input
                            type="text"
                            class="spec-name"
                            name="spec_name[]"
                            placeholder="e.g. Material Grade"
                          />
                          <input
                            type="text"
                            class="spec-value"
                            name="spec_value[]"
                            placeholder="e.g. SS 316"
                          />
                          <button type="button" class="btn-remove remove-spec-btn" title="Remove">
                            ×
                          </button>
                        </div>
                      </div>

                      <button type="button" class="btn-add-row" id="addSpecificationBtn">
                        <i class="bi bi-plus-lg"></i> Add Specification
                      </button>
                    </div>
                  </div>

                  <!-- 3 · RFQ Items -->
                  <div class="section-card" id="sec-items">
                    <div class="section-head">
                      <span class="section-index">03</span>
                      <span class="section-title">RFQ Items</span>
                    </div>
                    <div class="section-body">
                      <div class="row-header item-cols">
                        <span>Product / Item</span>
                        <span>Qty</span>
                        <span></span>
                      </div>

                      <div class="dynamic-rows" id="rfqItemsContainer">
                        <div class="item-row">
                          <select class="rfq-item-product" name="item_product[]">
                            <option value="">Select item</option>

                            <option value=""></option>
                          </select>
                          <input
                            type="number"
                            class="rfq-item-qty"
                            name="item_qty[]"
                            placeholder="Qty"
                            min="1"
                          />
                          <button type="button" class="btn-remove remove-item-btn" title="Remove">
                            ×
                          </button>
                        </div>
                      </div>

                      <button type="button" class="btn-add-row" id="addItemBtn">
                        <i class="bi bi-plus-lg"></i> Add Another Item
                      </button>
                    </div>
                  </div>

                  <!-- 4 · Budget & Deadline -->
                  <div class="section-card" id="sec-budget">
                    <div class="section-head">
                      <span class="section-index">04</span>
                      <span class="section-title">Budget & Deadline</span>
                    </div>
                    <div class="section-body">
                      <div class="field-row field">
                        <div class="field">
                          <label for="budgetMin">Minimum Budget <span class="req">*</span></label>
                          <div class="budget-wrap">
                            <span class="budget-prefix">₹</span>
                            <input
                              type="number"
                              id="budgetMin"
                              name="budgetMin"
                              placeholder="0"
                              min="0"
                              required
                            />
                          </div>
                        </div>
                        <div class="field">
                          <label for="budgetMax">Maximum Budget <span class="req">*</span></label>
                          <div class="budget-wrap">
                            <span class="budget-prefix">₹</span>
                            <input
                              type="number"
                              id="budgetMax"
                              name="budgetMax"
                              placeholder="0"
                              min="0"
                              required
                            />
                          </div>
                        </div>
                      </div>

                      <div class="field">
                        <label for="rfqDeadline">Bid Deadline <span class="req">*</span></label>
                        <input type="date" id="rfqDeadline" name="rfqDeadline" required />
                        <p class="field-hint">
                          Suppliers will not be able to submit quotes after this date.
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- 5 · Invite Suppliers -->

                  <!-- Submit bar -->
                  <div class="submit-bar">
                    <span class="submit-note">
                      Fields marked <strong style="color: var(--col-danger)">*</strong> are required
                      &nbsp;·&nbsp;
                      <span id="autosaveStatus" style="color: var(--col-text-muted)"></span>
                    </span>
                    <div class="submit-actions">
                      <button type="button" class="btn-discard" onclick="confirmDiscard()">
                        Discard
                      </button>
                      <button type="button" class="btn-draft" onclick="saveDraft()">
                        <i class="bi bi-floppy"></i> Save Draft
                      </button>
                      <button type="submit" class="btn-submit-rfq" id="rfqSubmitBtn">
                        <i class="bi bi-send"></i> Publish RFQ
                      </button>
                    </div>
                  </div>
                </div>
                <!-- /form-sections -->
              </form>
            </div>
          </div>
          <!-- /rfq-layout -->
        </div>
        <!-- /page-content -->
      </div>
      <!-- /main -->
    </div>
    <!-- /shell -->

    <!-- Toast container -->
    <div class="toast-wrap" id="toastWrap"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/company.js"></script>
    <script type="module" src="../assets/js/company/newRFQ/newRFQ.main.js"></script>
    <script type="module" src="../assets/js/company/profile/profile.main.js"></script>

    <script>
      // ── Mobile sidebar toggle ──
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !menuToggle.contains(e.target))
            sidebar.classList.remove('open');
        });
      }

      // ── User popup ──
      const userCard = document.getElementById('userCard');
      const userPopup = document.getElementById('userPopup');
      if (userCard && userPopup) {
        userCard.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = userPopup.classList.toggle('open');
          userCard.classList.toggle('active', open);
        });
        document.addEventListener('click', (e) => {
          if (!userCard.contains(e.target) && !userPopup.contains(e.target)) {
            userPopup.classList.remove('open');
            userCard.classList.remove('active');
          }
        });
      }

      // ── Priority pills → hidden select sync ──
      document.querySelectorAll('.ppill-input').forEach((r) => {
        r.addEventListener('change', () => {
          document.getElementById('rfqPriorityVal').value = r.value;
        });
      });

      // ── Set min date = today ──
      document.getElementById('rfqDeadline').min = new Date().toISOString().split('T')[0];

      // ── Toast helper ──
      function showToast(msg, type = 'success') {
        const wrap = document.getElementById('toastWrap');
        const el = document.createElement('div');
        el.className = `toast-msg ${type}`;
        el.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill'}"></i> ${msg}`;
        wrap.appendChild(el);
        setTimeout(() => el.remove(), 3500);
      }

      // ── Add / Remove Specifications ──
      document.getElementById('addSpecificationBtn').addEventListener('click', () => {
        const row = document.createElement('div');
        row.className = 'spec-row';
        row.innerHTML = `
          <input type="text" class="spec-name" name="spec_name[]" placeholder="Specification Name" />
          <input type="text" class="spec-value" name="spec_value[]" placeholder="Specification Value" />
          <button type="button" class="btn-remove remove-spec-btn" title="Remove">×</button>
        `;
        document.getElementById('specificationsContainer').appendChild(row);
        bindRemove();
      });

      function renderSavedItems() {
        const container = document.getElementById('savedItemsContainer');

        container.innerHTML = '';

        rfqState.rfqItems.forEach((item, index) => {
          container.innerHTML += `
      <div>
        ${item.product} — Qty: ${item.qty} — ${item.spec}
        <button onclick="removeItem(${index})">X</button>
      </div>
    `;
        });
      }
      window.removeItem = function (index) {
        rfqState.rfqItems.splice(index, 1);
        renderSavedItems();
      };
      function bindRemove() {
        document.querySelectorAll('.remove-spec-btn').forEach((btn) => {
          btn.onclick = () => {
            if (document.querySelectorAll('#specificationsContainer .spec-row').length > 1) {
              btn.closest('.spec-row').remove();
            }
          };
        });
      }

      bindRemove();

      // ── Collect form data ──
      function collectFormData() {
        const specs = [];
        document.querySelectorAll('#specificationsContainer .spec-row').forEach((row) => {
          const n = row.querySelector('.spec-name').value.trim();
          const v = row.querySelector('.spec-value').value.trim();
          if (n || v) specs.push({ specName: n, specValue: v });
        });

        const items = [];
        let totalQuantity = 0;
        document.querySelectorAll('#rfqItemsContainer .item-row').forEach((row) => {
          const productSelect = row.querySelector('.rfq-item-product');
          const productName = productSelect.options[productSelect.selectedIndex].text;
          const qty = Number(row.querySelector('.rfq-item-qty').value || 0);
          if (productName && qty > 0) {
            items.push({
              productName,
              quantity: qty,
            });
            totalQuantity += qty;
          }
        });

        return {
          title: document.getElementById('rfqTitle').value.trim(),
          categoryId: document.getElementById('rfqCategory').value,
          description: document.getElementById('rfqDescription').value.trim(),
          location: document.getElementById('rfqLocation').value.trim(),
          priority: document.getElementById('rfqPriorityVal').value,
          specifications: specs,
          items: items,
          totalQuantity,
          budgetMin: document.getElementById('budgetMin').value,
          budgetMax: document.getElementById('budgetMax').value,
          deadline: document.getElementById('rfqDeadline').value,
        };
      }

      // ── Save Draft ──
      const DRAFT_KEY = 'procurepro_rfq_draft';

      function saveDraft() {
        const btn = document.getElementById('saveDraftBtn');
        btn.classList.add('saving');
        btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Saving…';

        const data = collectFormData();
        data._savedAt = new Date().toISOString();
        localStorage.setItem(DRAFT_KEY, JSON.stringify(data));

        setTimeout(() => {
          btn.classList.remove('saving');
          btn.classList.add('saved');
          btn.innerHTML = '<i class="bi bi-check-lg"></i> Draft Saved';
          updateAutosaveStatus(data._savedAt);
          showToast('Draft saved successfully', 'success');
          setTimeout(() => {
            btn.classList.remove('saved');
            btn.innerHTML = '<i class="bi bi-floppy"></i> Save Draft';
          }, 2500);
        }, 600);
      }

      function updateAutosaveStatus(isoDate) {
        if (!isoDate) return;
        const d = new Date(isoDate);
        const time = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        document.getElementById('autosaveStatus').textContent = `Draft auto-saved at ${time}`;
      }

      // ── Resume Draft ──
      function resumeDraft() {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);

        if (data.rfqTitle) document.getElementById('rfqTitle').value = data.rfqTitle;
        if (data.rfqCategory) document.getElementById('rfqCategory').value = data.rfqCategory;
        if (data.rfqDescription)
          document.getElementById('rfqDescription').value = data.rfqDescription;
        if (data.rfqLocation) document.getElementById('rfqLocation').value = data.rfqLocation;
        if (data.rfqDeadline) document.getElementById('rfqDeadline').value = data.rfqDeadline;
        if (data.budgetMin) document.getElementById('budgetMin').value = data.budgetMin;
        if (data.budgetMax) document.getElementById('budgetMax').value = data.budgetMax;

        if (data.rfqPriority) {
          const radio = document.querySelector(`.ppill-input[value="${data.rfqPriority}"]`);
          if (radio) {
            radio.checked = true;
            document.getElementById('rfqPriorityVal').value = data.rfqPriority;
          }
        }

        // Specs
        if (data.specifications && data.specifications.length) {
          const container = document.getElementById('specificationsContainer');
          container.innerHTML = '';
          data.specifications.forEach((s) => {
            const row = document.createElement('div');
            row.className = 'spec-row';
            row.innerHTML = `
              <input type="text" class="spec-name"  name="spec_name[]"  value="${s.specName || ''}" placeholder="Specification Name" />
              <input type="text" class="spec-value" name="spec_value[]" value="${s.specValue || ''}" placeholder="Specification Value" />
              <button type="button" class="btn-remove remove-spec-btn" title="Remove">×</button>
            `;
            container.appendChild(row);
          });
          bindRemove();
        }

        // Items
        if (data.items && data.items.length) {
          const container = document.getElementById('rfqItemsContainer');
          container.innerHTML = '';
          data.items.forEach((item) => {
            const row = document.createElement('div');
            row.className = 'item-row';
            row.innerHTML = `
              <select class="rfq-item-product" name="item_product[]">
                <option value="${item.product_id || ''}">${item.product_id ? 'Product #' + item.product_id : 'Select item'}</option>
              </select>
              <input type="number" class="rfq-item-qty"  name="item_qty[]"  value="${item.quantity || ''}" placeholder="Qty" min="1" />
              <button type="button" class="btn-remove remove-item-btn" title="Remove">×</button>
            `;
            container.appendChild(row);
          });
          bindRemove();
        }

        document.getElementById('draftBanner').classList.remove('show');
        updateAutosaveStatus(data._savedAt);
        showToast('Draft restored', 'success');
      }

      function discardDraft() {
        localStorage.removeItem(DRAFT_KEY);
        document.getElementById('draftBanner').classList.remove('show');
        showToast('Draft discarded', 'warning');
      }

      // Show banner if draft exists on load
      window.addEventListener('DOMContentLoaded', () => {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (raw) {
          try {
            const d = JSON.parse(raw);
            if (d.rfqTitle || d.rfqCategory) {
              document.getElementById('draftBanner').classList.add('show');
              updateAutosaveStatus(d._savedAt);
            }
          } catch (e) {
            localStorage.removeItem(DRAFT_KEY);
          }
        }
      });

      // ── Autosave every 60 seconds ──
      setInterval(() => {
        const data = collectFormData();
        if (data.rfqTitle || data.rfqCategory || data.rfqDescription) {
          data._savedAt = new Date().toISOString();
          localStorage.setItem(DRAFT_KEY, JSON.stringify(data));
          updateAutosaveStatus(data._savedAt);
        }
      }, 60000);

      // ── Scrollspy for form nav ──
      const sections = ['sec-basic', 'sec-specs', 'sec-items', 'sec-budget', 'sec-suppliers'];
      const navLinks = document.querySelectorAll('.fnav-item');
      window.addEventListener(
        'scroll',
        () => {
          let current = sections[0];
          sections.forEach((id) => {
            const el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top <= 100) current = id;
          });
          navLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === '#' + current);
          });
        },
        { passive: true },
      );

      // ── Discard confirmation ──
      function confirmDiscard() {
        if (confirm('Discard this RFQ? Any unsaved changes will be lost.')) {
          localStorage.removeItem(DRAFT_KEY);
          window.location.href = '/rfq';
        }
      }

      // ── Form submit ──

      function handleSubmit(e) {
        e.preventDefault();

        const payload = collectFormData();
        console.log(payload);

        fetch('/company/api/v1/rfq/new-rfq', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        })
          .then((res) => res.json())
          .then((d) => {
            console.log(d);

            if (d.status === 'Success') {
              localStorage.removeItem(DRAFT_KEY);
              window.location.href = '/rfq/' + d.data.rfqId;
            } else {
              alert(d.message || 'RFQ creation failed');
            }
          })
          .catch((err) => {
            console.error(err);
            alert('Something went wrong');
          });
      }
    </script>
  </body>
</html>
