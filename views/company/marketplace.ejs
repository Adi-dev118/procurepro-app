<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Marketplace — ProcurePro</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../assets/css/style.css" />
    <link rel="stylesheet" href="../assets/css/company-style.css" />
  </head>
  <body>
    <div class="shell">
      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
          <div class="logo-mark">P</div>
          <div>
            <div class="logo-name">ProcurePro</div>
            <div class="logo-badge">BUYER</div>
          </div>
        </div>
        <nav class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <a href="/dashboard" class="nav-item"
            ><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a
          >
          <a href="/marketplace" class="nav-item active"
            ><i class="bi bi-shop"></i><span>Marketplace</span></a
          >
          <a href="/rfq" class="nav-item"
            ><i class="bi bi-megaphone"></i><span>RFQ Center</span
            ><span class="nav-badge warning">5</span></a
          >
          <div class="sidebar-section-label">Procurement</div>
          <a href="/orders" class="nav-item"
            ><i class="bi bi-cart-check"></i><span>Orders</span><span class="nav-badge">3</span></a
          >
          <a href="/contracts" class="nav-item"
            ><i class="bi bi-file-earmark-text"></i><span>Contracts</span></a
          >
          <a href="/invoices" class="nav-item"
            ><i class="bi bi-receipt"></i><span>Invoices</span></a
          >
          <a href="/suppliers" class="nav-item"
            ><i class="bi bi-people"></i><span>Suppliers</span></a
          >
          <div class="sidebar-section-label">Account</div>
          <a href="/analytics" class="nav-item"
            ><i class="bi bi-bar-chart-line"></i><span>Analytics</span></a
          >
          <a href="/profile" class="nav-item"
            ><i class="bi bi-person-circle"></i><span>Profile & Team</span></a
          >
          <a href="/settings" class="nav-item"><i class="bi bi-gear"></i><span>Settings</span></a>
        </nav>
        <div class="sidebar-footer">
          <div class="user-popup" id="userPopup">
            <div class="user-popup-header">My Account</div>
            <a href="/profile" class="user-popup-item">
              <i class="bi bi-person-circle"></i> Profile
            </a>
            <a href="/cart" class="user-popup-item"> <i class="bi bi-cart3"></i> Cart </a>
            <a href="/settings" class="user-popup-item"> <i class="bi bi-gear"></i> Settings </a>
            <div class="user-popup-divider"></div>
            <a href="/company/login" class="user-popup-item danger">
              <i class="bi bi-box-arrow-left"></i> Sign Out
            </a>
          </div>

          <!-- User Card Trigger -->
        <div class="user-card" id="userCard"></div>
          </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <button class="icon-btn d-lg-none" id="menuToggle" style="border: none">
            <i class="bi bi-list" style="font-size: 18px"></i>
          </button>
          <span class="topbar-title d-none d-md-block">Marketplace</span>
          <div class="topbar-search ms-auto ms-md-0">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search products, suppliers, categories…" />
          </div>
          <div class="topbar-actions">
            <div class="icon-btn">
              <i class="bi bi-bell" style="font-size: 15px"></i><span class="dot"></span>
            </div>
            <button
              class="btn-primary-action"
              data-bs-toggle="modal"
              data-bs-target="#createRFQModal"
            >
              <i class="bi bi-megaphone"></i> Create RFQ
            </button>
          </div>
        </header>

        <div class="page-content">
          <div class="page-header">
            <div>
              <div class="page-title">Marketplace</div>
              <div class="page-subtitle">Browse products from 100+ verified suppliers</div>
            </div>
            <div style="display: flex; gap: 10px; align-items: center">
              <div class="btn-ghost"><i class="bi bi-grid-3x3-gap"></i></div>
              <div class="btn-ghost"><i class="bi bi-list-ul"></i></div>
            </div>
          </div>

          <!-- Filter Panel -->
          <div class="filter-panel">
            <div class="filter-row">
              <div class="filter-group">
                <label>Category</label>
                <div class="filter-tags">
                  <span class="ftag active">All</span>
                  <span class="ftag">Machinery</span>
                  <span class="ftag">Tools</span>
                  <span class="ftag">Materials</span>
                  <span class="ftag">Components</span>
                  <span class="ftag">Services</span>
                </div>
              </div>
              <div class="filter-group">
                <label>Price Range</label>
                <div class="price-row">
                  <input type="number" class="price-input" placeholder="Min" value="0" />
                  <span class="price-sep">—</span>
                  <input type="number" class="price-input" placeholder="Max" value="10000" />
                </div>
              </div>
              <div class="filter-group">
                <label>Location</label>
                <select class="filter-select">
                  <option>Any Location</option>
                  <option>North America</option>
                  <option>Europe</option>
                  <option>Asia</option>
                  <option>Local (Within 100km)</option>
                </select>
              </div>
              <div class="filter-group">
                <label>Supplier Rating</label>
                <select class="filter-select">
                  <option>Any Rating</option>
                  <option>4+ Stars</option>
                  <option>3+ Stars</option>
                  <option>Verified Only</option>
                </select>
              </div>
            </div>
            <div class="filter-footer">
              <div class="results-count"><span>245</span> products found</div>
              <div class="filter-actions">
                <button class="btn-ghost"><i class="bi bi-x-circle"></i> Clear filters</button>
                <button class="btn-ghost"><i class="bi bi-funnel"></i> More filters</button>
                <select class="filter-select" style="width: auto">
                  <option>Sort: Popularity</option>
                  <option>Price: Low to High</option>
                  <option>Price: High to Low</option>
                  <option>Rating</option>
                  <option>Newest</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Products Grid -->
          <div class="products-grid"></div>

          <!-- Pagination -->
          <div class="company-pagination-container mt-4">
            <div class="pagination-info"></div>
            <nav>
              <ul class="pagination" id="pagination"></ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
    <!-- Add this modal before closing </body> in marketplace.ejs -->

    <div
      class="modal fade"
      id="directOrderModal"
      tabindex="-1"
      aria-labelledby="directOrderModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 14px; border: none">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="directOrderModalLabel">Direct Order</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold">Product Name</label>
              <input type="text" id="modalProductName" class="form-control" readonly />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Price</label>
              <input type="text" id="modalProductPrice" class="form-control" readonly />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Quantity</label>

              <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary" id="decreaseQtyBtn">
                  -
                </button>

                <input
                  type="number"
                  id="modalProductQty"
                  class="form-control text-center"
                  value="1"
                  min="1"
                  style="max-width: 100px"
                />

                <button type="button" class="btn btn-outline-secondary" id="increaseQtyBtn">
                  +
                </button>
              </div>
            </div>

            <input type="hidden" id="modalProductId" />
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

            <button type="button" class="btn btn-primary" id="addToCartBtn">Add to Cart</button>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../assets/js/company.js"></script>
    <script type="module" src="../assets/js/company/product/product.main.js"></script>
    <script type="module" src="../assets/js/company/profile/profile.main.js"></script>

    <script>
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        document.addEventListener('click', (e) => {
          if (!sidebar.contains(e.target) && !menuToggle.contains(e.target))
            sidebar.classList.remove('open');
        });
      }

      // ── User Account Popup ──
      const userCard = document.getElementById('userCard');
      const userPopup = document.getElementById('userPopup');
      if (userCard && userPopup) {
        userCard.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = userPopup.classList.toggle('open');
          userCard.classList.toggle('active', isOpen);
        });
        document.addEventListener('click', (e) => {
          if (!userCard.contains(e.target) && !userPopup.contains(e.target)) {
            userPopup.classList.remove('open');
            userCard.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>
